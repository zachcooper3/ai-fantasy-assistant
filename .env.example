# Copy this file to .env and fill in your values.

# --- Required for AI recommendations ---
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# --- Optional: rookie college production (py -m backend.ingestion.fetch_college_stats) ---
# Free key, no credit card, email signup: https://collegefootballdata.com/key
# Unset (or left as this placeholder) -> that script no-ops with a clear log
# message; everything else in the app works fine without it.
CFBD_API_KEY=your_key_here

# --- Recommended before deploying (optional for local dev) ---
# Shared API token. Unset -> auth is disabled (fine on localhost). Set it
# before exposing the backend publicly (e.g. Render): without it, anyone
# can reset your draft mid-round or spam paid AI recommendation calls.
# Use a long random value (e.g. `openssl rand -hex 32`) and set the SAME
# value as NEXT_PUBLIC_API_TOKEN in the frontend's .env.local.
# APP_AUTH_TOKEN=your_token_here

# --- Optional overrides ---
# Model used for per-pick recommendations (default: claude-haiku-4-5-20251001)
# Switch to claude-sonnet-5 for richer analysis (slower, higher cost) — or
# leave this alone and use the Haiku/Sonnet toggle in the AI panel instead,
# which switches live without a backend restart. This env var only sets the
# INITIAL model on boot (see AI_MODEL_CHOICES in ai_service.py); the toggle
# overrides it for the rest of that run, and persists the choice across a
# restart via DraftSession.ai_model once a draft is active.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Path to the SQLite database file (default: data/fantasy.db)
DB_PATH=data/fantasy.db

# Model used for the batch "what it means" scouting-note synthesis
# (py -m backend.ingestion.fetch_synthesis). Defaults to CLAUDE_MODEL/Haiku;
# override independently since this runs offline and can afford a pricier
# model if you want richer notes.
# SYNTHESIS_MODEL=claude-sonnet-5

# Comma-separated list of allowed frontend origins (CORS). Defaults cover
# local dev (localhost:3000/5173) — set this to your deployed frontend URL
# (e.g. the Vercel URL) once you go live, instead of editing main.py.
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
