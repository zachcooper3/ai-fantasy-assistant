# Copy this file to .env and fill in your values.

# --- Required for AI recommendations ---
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# --- Optional overrides ---
# Model used for per-pick recommendations (default: claude-haiku-4-5-20251001)
# Switch to claude-sonnet-4-6 for richer analysis (slower, higher cost)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Path to the SQLite database file (default: data/fantasy.db)
DB_PATH=data/fantasy.db

# Comma-separated list of allowed frontend origins (CORS). Defaults cover
# local dev (localhost:3000/5173) — set this to your deployed frontend URL
# (e.g. the Vercel URL) once you go live, instead of editing main.py.
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
