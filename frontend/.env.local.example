# Copy to .env.local
# URL of the FastAPI backend — defaults to localhost:8000 in dev
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared API token — must match APP_AUTH_TOKEN on the backend. Leave unset
# in local dev (backend auth is disabled when APP_AUTH_TOKEN is unset).
# CAVEAT: NEXT_PUBLIC_* values are baked into the public JS bundle, so
# anyone who loads the deployed frontend can extract this token — treat
# the frontend URL itself as semi-secret. See backend/app/auth.py.
# NEXT_PUBLIC_API_TOKEN=your_token_here
NEXT_PUBLIC_API_TOKEN=4v9K8mX2pLq7wR3zN5fY1hB6dK9jM2vC5xQ8bT4nF7hW1gP3mL6kS9